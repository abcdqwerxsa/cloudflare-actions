{
  "checks": [
    {
      "name": "GitHub Repo Metadata",
      "method": "GET",
      "url": "https://api.github.com/repos/cloudflare/workers-sdk",
      "headers": {
        "Accept": "application/vnd.github+json"
      },
      "expected_status": 200,
      "expected_json_keys": [
        "full_name",
        "owner.login",
        "stargazers_count"
      ],
      "enabled": true
    },
    {
      "name": "JSONPlaceholder Create Post",
      "method": "POST",
      "url": "https://jsonplaceholder.typicode.com/posts",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "title": "Cloudflare Actions smoke probe",
        "body": "Synthetic request generated by Cloudflare Actions.",
        "userId": 1
      },
      "expected_status": 201,
      "expected_json_keys": [
        "id",
        "title"
      ],
      "enabled": true
    }
  ]
}
